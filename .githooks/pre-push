#!/usr/bin/env sh
# Checks every commit about to leave: identities, messages, file names, and the
# tree as it will be published. The CI runs after the push — too late for this.
allzero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }
while read -r _lref lsha _rref rsha; do
  allzero "$lsha" && continue            # branch deletion: nothing leaves
  if allzero "$rsha"; then range="$lsha"; else range="$rsha..$lsha"; fi
  "$(git rev-parse --show-toplevel)/scripts/check-personal.sh" --range "$range" || exit 1
done
